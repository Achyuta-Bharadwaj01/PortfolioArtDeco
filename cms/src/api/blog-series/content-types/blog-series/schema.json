{
  "kind": "collectionType",
  "collectionName": "blog_series",
  "info": {
    "singularName": "blog-series",
    "pluralName": "series",
    "displayName": "Blog Series",
    "description": "A named group of essays, such as Design Therapy."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "tagline": {
      "type": "text",
      "required": true
    },
    "episodes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-episode.blog-episode",
      "mappedBy": "series"
    }
  }
}
